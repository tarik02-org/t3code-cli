{
  "name": "t3cli",
  "version": "1.0.0",
  "description": "CLI for t3code",
  "keywords": [
    "claude",
    "cli",
    "codex",
    "t3code"
  ],
  "homepage": "https://github.com/tarik02/t3cli#readme",
  "bugs": {
    "url": "https://github.com/tarik02/t3cli/issues"
  },
  "license": "MIT",
  "author": "tarik02 <taras.fomin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02/t3cli.git"
  },
  "bin": {
    "t3cli": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepack": "pnpm build",
    "release:check": "pnpm check && pnpm typecheck && pnpm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.74",
    "@types/node": "^25.9.1",
    "effect": "4.0.0-beta.74",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.22"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
