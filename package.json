{
  "name": "t3code-cli",
  "version": "0.3.0",
  "description": "CLI for t3code",
  "keywords": [
    "claude",
    "cli",
    "codex",
    "t3code"
  ],
  "homepage": "https://github.com/tarik02/t3cli#readme",
  "bugs": {
    "url": "https://github.com/tarik02/t3cli/issues"
  },
  "license": "MIT",
  "author": "tarik02 <taras.fomin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02/t3cli.git"
  },
  "bin": {
    "t3cli": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "imports": {
    "#t3tools/contracts": {
      "types": "./dist/upstream-t3code/packages/contracts/src/index.d.ts",
      "default": "./dist/upstream-t3code/packages/contracts/src/index.d.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.dts.json",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "release:check": "pnpm check && pnpm typecheck && pnpm pack --dry-run",
    "release:publish": "changeset publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.78",
    "effect": "4.0.0-beta.78"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@t3tools/contracts": "workspace:*",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.24"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
